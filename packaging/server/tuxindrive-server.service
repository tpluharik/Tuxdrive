[Unit]
Description=TuxInDrive encrypted coordination and synchronization server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tuxindrive-server
Group=tuxindrive-server
ExecStartPre=/usr/bin/tuxindrive-server check --config /etc/tuxindrive-server/server.json
ExecStart=/usr/bin/tuxindrive-server serve --config /etc/tuxindrive-server/server.json
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tuxindrive-server
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
TasksMax=128
LimitNOFILE=4096
MemoryMax=768M
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
