#!/bin/sh
export PYTHONPATH="/usr/lib/tuxdrive${PYTHONPATH:+:$PYTHONPATH}"
state_root="${XDG_STATE_HOME:-${HOME}/.local/state}/tuxdrive"
mkdir -p "$state_root"
chmod 700 "$state_root"
printf '\n=== launcher %s ===\n' "$(date --iso-8601=seconds)" >>"$state_root/startup.log"
exec /usr/bin/python3 -m tuxdrive.app "$@" >>"$state_root/startup.log" 2>&1
