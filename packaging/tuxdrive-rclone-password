#!/bin/sh
set -eu
secret_tool=/usr/bin/secret-tool
if [ ! -x "$secret_tool" ]; then
  echo "TuxDrive cannot access GNOME Secret Service" >&2
  exit 1
fi
password=$($secret_tool lookup application tuxdrive purpose rclone-config 2>/dev/null || true)
if [ -z "$password" ] && [ "${1:-}" = "--ensure" ]; then
  password=$(/usr/bin/head -c 48 /dev/urandom | /usr/bin/base64 -w0)
  printf '%s' "$password" | $secret_tool store --label='TuxDrive rclone configuration' application tuxdrive purpose rclone-config >/dev/null
fi
if [ -z "$password" ]; then
  echo "TuxDrive configuration key is unavailable" >&2
  exit 1
fi
printf '%s\n' "$password"
