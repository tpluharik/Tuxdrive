[Unit]
Description=TuxDrive cloud synchronization client
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/tuxdrive --background
Restart=on-failure
RestartSec=10
UMask=0077
PrivateTmp=yes
LockPersonality=yes

[Install]
WantedBy=default.target
